# ── AgentCore Payments → Ampersend → BlockRun Demo (v2) ──────────
# Copy to .env and fill in values.

# ── AWS / AgentCore (buyer side) ──────────────────────────────────
# Buyer uses ProcessPaymentRole + ProcessPayment only (Private Preview guide).
# MANAGER_ARN, PAYMENT_SESSION_ID, PAYMENT_INSTRUMENT_ID must come from the
# application/backend path (ManagementRole) — e.g. ../scripts/e2e-test.sh output.
AWS_REGION=us-west-2
# AWS_PROFILE=default
DP_ENDPOINT=https://bedrock-agentcore.us-west-2.amazonaws.com
# Single-quote values — unquoted <...> breaks `source .env` (redirection).
MANAGER_ARN='PASTE_PAYMENT_MANAGER_ARN'
PROCESS_PAYMENT_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsProcessPaymentRole'
PAYMENT_SESSION_ID='PASTE_PAYMENT_SESSION_ID'
PAYMENT_INSTRUMENT_ID='PASTE_PAYMENT_INSTRUMENT_ID'
USER_ID=demo-user

# Optional (v2): enables the post-payment GetPaymentSession budget readout.
# ManagementRole has GetPaymentSession; ProcessPaymentRole does NOT — the
# buyer briefly re-assumes this role to print the remaining budget.
# MANAGEMENT_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsManagementRole'

# ── Ampersend / Seller ────────────────────────────────────────────
SELLER_SMART_ACCOUNT_ADDRESS=0x...
SELLER_SESSION_KEY=0x...
AMPERSEND_API_URL=https://api.staging.ampersend.ai

# ── Network ──────────────────────────────────────────────────────
NETWORK=base-sepolia

# ── Seller server ────────────────────────────────────────────────
SELLER_PORT=8002
SELLER_URL=http://localhost:8002/v1/chat/completions

# ── Model catalog (v2: pay-per-intelligence tiers) ───────────────
# The seller exposes GET /v1/models listing these tiers. Buyers pick a tier
# (fast/balanced/premium) based on prompt complexity; each tier maps to a
# BlockRun model at a different price.
#
# Default (used when MODEL_CATALOG is unset):
#   [fast]     $0.001  openai/gpt-oss-20b
#   [balanced] $0.003  openai/gpt-oss-120b
#   [premium]  $0.008  deepseek/deepseek-v3
#
# To override, set MODEL_CATALOG to a JSON array:
# MODEL_CATALOG='[
#   {"id":"fast","model":"openai/gpt-oss-20b","price_micro_usdc":1000,"description":"Fast, cheap"},
#   {"id":"balanced","model":"openai/gpt-oss-120b","price_micro_usdc":3000,"description":"Balanced"},
#   {"id":"premium","model":"deepseek/deepseek-v3","price_micro_usdc":8000,"description":"Premium"}
# ]'
#
# Legacy single-model knobs (v1) still work — they override the fast tier:
# BLOCKRUN_MODEL=openai/gpt-oss-20b
# PRICE_MICRO_USDC=1000

# ── Facilitator ──────────────────────────────────────────────────
FACILITATOR_URL=https://www.x402.org/facilitator
# If settle fails with invalid_exact_evm_transaction_failed but the payer
# wallet has Base Sepolia USDC (check basescan), try an alternate facilitator:
# FACILITATOR_URL=https://facilitator.xpay.sh
# Optional: gas hint for EIP-3009 settle on Base Sepolia (default 300000 in code)
# X402_USDC_GAS_LIMIT=300000
# MAX_TIMEOUT_SECONDS=120

# Set to "true" to skip facilitator verification (LOCAL DEV ONLY — the
# seller will print a large warning at startup).
# SKIP_VERIFY=true
