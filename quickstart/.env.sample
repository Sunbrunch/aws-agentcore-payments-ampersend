# AgentCore Payments — quickstart (setup_manager.py)
# Copy to .env in this directory and replace every <...> placeholder.
# Do not commit .env (see repo .gitignore).
#
# Quote values that contain +, =, or / (e.g. COINBASE_API_KEY_SECRET='...').

COINBASE_API_KEY_ID='<COINBASE_API_KEY_ID>'
COINBASE_API_KEY_SECRET='<COINBASE_API_KEY_SECRET>'
COINBASE_WALLET_SECRET='<COINBASE_WALLET_SECRET>'

# Optional — defaults shown in setup_manager.py when unset
# AWS_REGION=us-west-2
# DEFAULT_PAYMENT_MANAGER_NAME=
# DEFAULT_PAYMENT_CONNECTOR_NAME=
# CREDENTIAL_PROVIDER_ENDPOINT=
# PAYMENTS_CP_ENDPOINT=
