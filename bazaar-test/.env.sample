# AgentCore Payments — Bazaar Test Configuration
# Fill in values from quickstart + e2e-test output.

AWS_REGION=us-west-2
# AWS_PROFILE=default  # Uncomment to use a named AWS CLI profile

# Data Plane endpoint (production)
DP_ENDPOINT=https://bedrock-agentcore.us-west-2.amazonaws.com

# From quickstart output (single-quote — unquoted <...> breaks `source .env`)
MANAGER_ARN='PASTE_PAYMENT_MANAGER_ARN'
CONNECTOR_ID='PASTE_CONNECTOR_ID'

# IAM role for payment execution (agent)
PROCESS_PAYMENT_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsProcessPaymentRole'

# Pre-provisioned by the application backend (ManagementRole)
PAYMENT_SESSION_ID='PASTE_PAYMENT_SESSION_ID'
PAYMENT_INSTRUMENT_ID='PASTE_PAYMENT_INSTRUMENT_ID'
USER_ID=test-user-12345
