# =============================================================
# Data Plane E2E Test Configuration
#
# Fill in the values from the quickstart setup output.
# =============================================================

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default  # Uncomment to use a named AWS CLI profile

# Service Endpoints (production)
CP_ENDPOINT=https://bedrock-agentcore-control.us-west-2.amazonaws.com
DP_ENDPOINT=https://bedrock-agentcore.us-west-2.amazonaws.com

# From quickstart output (DP APIs use managerArn, not managerId)
# Use single quotes — unquoted <...> is shell redirection when you `source` this file.
MANAGER_ARN='PASTE_PAYMENT_MANAGER_ARN'
CONNECTOR_ID='PASTE_CONNECTOR_ID'

# Control Plane role (for CP SDK tests)
CONTROL_PLANE_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsControlPlaneRole'

# IAM role for instrument/session management (application backend)
# Has: CreatePaymentInstrument, GetPaymentInstrument, ListPaymentInstruments,
#      CreatePaymentSession, GetPaymentSession, ListPaymentSessions, etc.
# Denies: ProcessPayment
MANAGEMENT_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsManagementRole'

# IAM role for payment execution only (agent / deterministic code path)
# Has: ProcessPayment only
# Cannot: create sessions, instruments, or override budgets
PROCESS_PAYMENT_ROLE_ARN='arn:aws:iam::ACCOUNT_ID:role/AgentCorePaymentsProcessPaymentRole'

# Test user ID (can be any string)
USER_ID=test-user-12345

# Session spending limit in USD (string value)
SESSION_LIMIT_USD=1000000.0

# Payment amount in smallest unit (100000 = $0.10 USDC)
PAYMENT_AMOUNT=100000

# x402 payment recipient (default: Coinbase test address)
PAY_TO=0x312554704B5c47b992e876639B144e9B85431E44
